# Go Backend Environment Configuration
PORT=8080

# Microsoft SQL Server (Local Instance)
MSSQL_SERVER=LAPTOP-OV8LM74T\MSSQLSERVERANIL
MSSQL_DATABASE=TradeDB
# Note: Windows Authentication (Trusted Connection) is used by default.
# If using SQL Server Authentication, set these:
