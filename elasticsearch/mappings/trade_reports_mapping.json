{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s"
  },
  "mappings": {
    "dynamic": true,
    "properties": {
      "trade_id":      { "type": "keyword" },
      "order_id":      { "type": "keyword" },
      "client_id":     { "type": "keyword" },
      "client_code":   { "type": "keyword" },
      "first_name":    { "type": "text", "fields": { "raw": { "type": "keyword" } } },
      "last_name":     { "type": "text", "fields": { "raw": { "type": "keyword" } } },
      "account_type":  { "type": "keyword" },
      "symbol":        { "type": "keyword" },
      "company_name":  { "type": "text", "fields": { "raw": { "type": "keyword" } } },
      "sector":        { "type": "keyword" },
      "exchange":      { "type": "keyword" },
      "segment":       { "type": "keyword" },
      "trade_type":    { "type": "keyword" },
      "quantity":      { "type": "integer" },
      "price":         { "type": "double" },
      "trade_value":   { "type": "double" },
      "brokerage":     { "type": "double" },
      "taxes_charges": { "type": "double" },
      "net_amount":    { "type": "double" },
      "trade_status":  { "type": "keyword" },
      "trade_time":    { "type": "date" },
      "updated_on":    { "type": "date" },
      "indexed_at":    { "type": "date" }
    }
  }
}
